# The species name is NOT chosen yet. It lands in exactly three places:
# package.json, copy, and SITE_URL. Nothing else may hardcode it.
# Leave these empty until the owner picks the name.
PROJECT_SLUG=
SITE_URL=

# Postgres. Two separate databases, never the same one.
# The test database carries a `disposable_database` stamp written by the
# migrate-test script, and the test runner refuses to start without it.
DATABASE_URL=
TEST_DATABASE_URL=
