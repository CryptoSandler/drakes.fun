# The species is Drakes (docs/decisions.md D1, closed 2026-09-01).
# The name lands in exactly three places: package.json, copy, and SITE_URL.
# Nothing else hardcodes it -- code reads PROJECT_SLUG.
PROJECT_SLUG=drakes
SITE_URL=https://drakes.fun

# Postgres. Two separate databases, never the same one.
# The test database carries a `disposable_database` stamp written by the
# migrate-test script, and the test runner refuses to start without it.
DATABASE_URL=
TEST_DATABASE_URL=

# The issuance cranker (scripts/crank-loop.ts). See docs/crank-hosting.md.
# RPC_URL is the only endpoint it talks to; the cluster is classified from the
# genesis hash and a mismatch with the rig refuses to sign.
RPC_URL=
# Path to the crank keypair. Its total authority is spending its own SOL on
# permissionless instructions -- the program is written to be safe with this
# key public (DESIGN.md T4). It is never a key that can move the reserve.
CRANK_KEYPAIR=
# ntfy.sh: one message per hour that closed with no settlement. With none
# configured, alerts go to stderr and the cranker says so at start-up.
#
# THE TOPIC IS THE PASSWORD. ntfy has no accounts, so whoever knows it can read
# every alert and publish forgeries into the same channel. Generate it with
# `openssl rand -hex 16` -- the sink refuses anything shorter than 32 characters
# -- keep it in .env.local, and never let it reach a log.
NTFY_TOPIC=

# The site (app/). Server-side only: the browser never sees the RPC URL, so a
# deployment pointed at devnet cannot show mainnet (CLAUDE.md).
ISSUANCE_PROGRAM=
ISSUANCE_CONFIG=
# The survivor array. Without it the gallery cannot tell issued from waiting.
ISSUANCE_SURVIVORS=
COLLECTION_SIZE=4000
# The address whose $PUMP balance is the reserve. UNSET IN PHASE 1, and that is
# the honest state rather than a missing setting: the Phase 1 program holds
# nothing, which is what makes it deployable before the audit (D8). The page
# says so instead of rendering a zero.
RESERVE_OWNER=
# Overrides the $PUMP mint. Only a devnet rehearsal should ever set this.
PUMP_MINT=

# Railway (docs/crank-hosting.md). Only ever read from .env.local by the deploy
# step -- nothing in the application uses it, and the account and payment are
# the owner's. The service itself reads RPC_URL, CRANK_KEYPAIR, CRANK_RIG,
# NTFY_TOPIC and PORT.
RAILWAY_TOKEN=
# Which rig the cranker serves. The mainnet rig does not exist until B3 and B8.
CRANK_RIG=rigs/devnet-rehearsal.json
