{
  "name": "drakes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "next build",
    "check:migrations": "node scripts/check-migrations.ts",
    "crank": "node scripts/crank-loop.ts",
    "dev": "next dev",
    "index-events": "node scripts/index-events.ts",
    "lint": "eslint .",
    "migrate": "node scripts/migrate.ts",
    "migrate:preview": "DATABASE_URL=$PREVIEW_DATABASE_URL node scripts/migrate.ts",
    "migrate:test": "node scripts/migrate-test.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test",
    "verify:full": "node scripts/verify-full.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@meteora-ag/cp-amm-sdk": "^1.4.7",
    "@sqds/multisig": "^2.1.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@solana/web3.js": "^1.98.0",
    "@switchboard-xyz/on-demand": "^3.10.6",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
